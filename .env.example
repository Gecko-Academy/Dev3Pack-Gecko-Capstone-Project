# Copy to .env only if you need to override a default. .env is gitignored; this file is
# committed, so it never holds a value that matters. No key goes in either file: keys are
# FILES in ~/.config/dev3pack/, and these variables hold their PATHS.

# recorded = offline, from fixtures/. The rollback switch: it wins over --devnet.
GECKO_SOURCE=
# The hosted Gecko MCP (default https://mcp.geckovision.tech/orquestra/mcp)
GECKO_MCP_URL=
# Your devnet buyer key's PATH (default: from ~/.config/dev3pack/devnet.json)
GECKO_DEVNET_KEYPAIR=
# A devnet RPC (default https://api.devnet.solana.com). The signer checks its genesis hash.
GECKO_DEVNET_RPC=
# A mainnet RPC, Friday only (default https://api.mainnet-beta.solana.com). Genesis-checked too.
GECKO_MAINNET_RPC=
# The mint you pay with, as an ADDRESS (default: your own mint from devnet.json)
GECKO_PAY_MINT=
# Where keys live (default ~/.config/dev3pack). Never inside a repository.
DEV3PACK_HOME=
